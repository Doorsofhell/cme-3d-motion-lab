{
  "name": "@cme-3d/motion-lab",
  "version": "0.7.32",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && node scripts/validate-amara.mjs && node scripts/validate-naira.mjs && node scripts/validate-coach-assets.mjs && node scripts/audit-studio-materials.mjs && node scripts/audit-coach-capabilities.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:amara": "node scripts/validate-amara.mjs",
    "test:naira": "node scripts/validate-naira.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
